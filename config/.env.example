# Environment — комплект v1
# cp config/.env.example .env

# Core API
API_HOST=0.0.0.0
API_PORT=8080
SITE_CONFIG=config/site.yaml
DRY_RUN=true

# AI engine (отдельный сервис)
AI_ENGINE_URL=http://ai-engine:8090
ONNX_MODEL_DETECT=models/detect.onnx
ONNX_MODEL_CLASSIFY=models/classify.onnx

# ONVIF passwords (по одной на камеру или общая)
PTZ_ONVIF_PASSWORD=change_me
SKY_ONVIF_PASSWORD=change_me

# Recorder
RECORDINGS_DIR=data/recordings
RECORD_PRE_SECONDS=30
RECORD_POST_SECONDS=60

# Database
DATABASE_URL=sqlite:///data/catalog.db

# Turret (optional module)
TURRET_CONFIG=config/turret.yaml

# Operator UI & simulation
UI_PORT=3000
PIPELINE_MODE=live
SIMULATOR_URL=http://localhost:8070
CORE_URL=http://localhost:8080
